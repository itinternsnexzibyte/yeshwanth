generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  QUOTATION_USER
  VIEWER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum QuotationStatus {
  DRAFT
  ISSUED
  REVISED
  CANCELLED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  profileImagePath String?
  role         Role
  status       RecordStatus @default(ACTIVE)
  failedLogins Int          @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  quotations   Quotation[]
  audits       AuditLog[]
}

model Customer {
  id                   String       @id @default(cuid())
  customerCode         String       @unique
  companyName          String
  address              String
  gstNo                String?
  defaultPaymentTerms  String       @default("50% Advance")
  defaultDeliveryTerms String       @default("As mutually agreed")
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  contacts             CustomerContact[]
  quotations           Quotation[]
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  designation String?
  phone       String?
  email       String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  @@index([customerId])
}

model Product {
  id          String       @id @default(cuid())
  sku         String       @unique
  name        String
  description String
  packageSize String
  uom         String
  moq         Decimal      @db.Decimal(14, 3)
  gstRate     Decimal      @default(18) @db.Decimal(5, 2)
  imageKey    String?
  imagePath   String?
  details     String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  prices      ProductPrice[]
  items       QuotationItem[]
}

model ProductPrice {
  id            String   @id @default(cuid())
  productId     String
  listPrice     Decimal  @db.Decimal(14, 2)
  unitPrice     Decimal  @db.Decimal(14, 2)
  defaultDiscount Decimal @default(0) @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, effectiveFrom])
}

model PricingRule {
  id              String       @id @default(cuid())
  name            String
  scope           String       @default("GLOBAL")
  scopeId         String?
  formulaRef      String       @default("STANDARD_QTY_PRICE_DISCOUNT_GST")
  maxDiscount     Decimal?     @db.Decimal(5, 2)
  gstRateOverride Decimal?     @db.Decimal(5, 2)
  fixedFreight    Decimal?     @db.Decimal(14, 2)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([scope, scopeId, status])
}

model Template {
  id          String       @id @default(cuid())
  code        String
  name        String
  version     Int          @default(1)
  status      RecordStatus @default(ACTIVE)
  definition Json
  quotations Quotation[]
  @@unique([code, version])
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  revision        Int             @default(0)
  revisionOfId    String?
  customerId      String
  contactId       String?
  templateId      String
  templateVersion Int
  quotationDate   DateTime
  validUntil      DateTime
  subject         String
  reference       String?
  inquiry         String?
  clientCompanyName String?
  clientAddress String?
  clientGstin String?
  clientContactName String?
  clientContactDesignation String?
  clientEmail String?
  deliveryTerms   String
  paymentTerms    String
  terms           String
  notes           String?
  subtotal        Decimal         @db.Decimal(14, 2)
  discountAmount  Decimal         @db.Decimal(14, 2)
  taxableAmount   Decimal         @db.Decimal(14, 2)
  cgstAmount      Decimal         @db.Decimal(14, 2)
  sgstAmount      Decimal         @db.Decimal(14, 2)
  igstAmount      Decimal         @db.Decimal(14, 2)
  freightAmount   Decimal         @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal         @db.Decimal(14, 2)
  status          QuotationStatus @default(DRAFT)
  pdfPath         String?
  docxPath        String?
  accentColor     String?
  pdfLayout       String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        Customer        @relation(fields: [customerId], references: [id])
  contact         CustomerContact? @relation(fields: [contactId], references: [id])
  template        Template        @relation(fields: [templateId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  revisionOf      Quotation?      @relation("QuotationRevisions", fields: [revisionOfId], references: [id])
  revisions       Quotation[]     @relation("QuotationRevisions")
  items           QuotationItem[]
  @@index([customerId, createdAt])
  @@index([createdById, createdAt])
}

model QuotationItem {
  id                  String    @id @default(cuid())
  quotationId         String
  productId           String?
  skuSnapshot         String
  imageKeySnapshot    String?
  imagePathSnapshot   String?
  moqSnapshot         Decimal?  @db.Decimal(14, 3)
  detailsSnapshot     String?
  descriptionSnapshot String
  packageSizeSnapshot String
  uomSnapshot         String
  quantity            Decimal   @db.Decimal(14, 3)
  listPrice           Decimal   @db.Decimal(14, 2)
  unitPrice           Decimal   @db.Decimal(14, 2)
  discountRate        Decimal   @db.Decimal(5, 2)
  discountAmount      Decimal   @db.Decimal(14, 2)
  taxableAmount       Decimal   @db.Decimal(14, 2)
  gstRate             Decimal   @db.Decimal(5, 2)
  gstAmount           Decimal   @db.Decimal(14, 2)
  lineTotal           Decimal   @db.Decimal(14, 2)
  quotation           Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product             Product?  @relation(fields: [productId], references: [id])
  @@index([quotationId])
  @@index([productId])
}

model QuotationSequence {
  key        String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([entity, entityId])
  @@index([createdAt])
}
